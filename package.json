{
  "name": "foodlog-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm run setup:app && npm run setup:prototype",
    "setup:app": "npm --prefix apps/food-log ci",
    "setup:prototype": "npm --prefix prototype ci",
    "dev": "npm --prefix apps/food-log run dev",
    "start": "npm --prefix apps/food-log run start",
    "android": "npm --prefix apps/food-log run android",
    "ios": "npm --prefix apps/food-log run ios",
    "web": "npm --prefix apps/food-log run web",
    "prototype": "npm --prefix prototype run dev",
    "build": "npm --prefix apps/food-log run build",
    "format": "npm --prefix apps/food-log run format",
    "format:check": "npm --prefix apps/food-log run format:check",
    "lint": "npm --prefix apps/food-log run lint",
    "typecheck": "npm --prefix apps/food-log run typecheck",
    "test": "npm --prefix apps/food-log test",
    "test:watch": "npm --prefix apps/food-log run test:watch",
    "test:prototype": "npm --prefix prototype test"
  }
}
