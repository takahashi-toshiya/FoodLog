model NutritionGoal {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  calories      Int
  protein       Decimal  @db.Decimal(10, 2)
  fat           Decimal  @db.Decimal(10, 2)
  carbs         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectiveFrom])
  @@map("nutrition_goals")
}

model WeightRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  recordedDate DateTime @map("recorded_date") @db.Date
  weightKg     Decimal  @map("weight_kg") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedDate])
  @@map("weight_records")
}
